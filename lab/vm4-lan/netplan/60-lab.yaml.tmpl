# dnsmasq nghe tren ${VM4_IP} (bind-interfaces) nen VM4 cung hoi DNS qua IP nay.
network:
  version: 2
  ethernets:
    ${VM4_IF}:
      dhcp4: false
      addresses: [${VM4_IP}/24]
      routes:
        - to: default
          via: ${VM2_LAN_IP}
      nameservers:
        addresses: [${VM4_RESOLVER_IP}]
