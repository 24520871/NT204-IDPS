# Copy thanh lab/lab.env (khong commit) va dien gia tri that. Moi script trong lab/ doc file nay.

# --- Interface cua VM2 ---
IF_EXT=enp0s3
IF_DMZ=enp0s8
IF_LAN=enp0s9
IF_MGMT=enp0s10

# --- IP cac may (TODO: chot o S1) ---
VM1_KALI_IP=
VM1_UPDATE_SERVER_IP=     # IP alias: may chu cap nhat lanh tinh
VM1_C2_IP=                # IP alias: C2
VM1_EXFIL_IP=             # IP alias: dich exfil
VM2_EXT_IP=
VM2_DMZ_IP=
VM2_LAN_IP=
VM2_MGMT_IP=
VM3_WEB_IP=
VM4_LAN_IP=
VM4_RESOLVER_IP=
VM5_SPLUNK_IP=

# --- Block Agent ---
BLOCK_AGENT_PORT=8443
# Token KHONG de o day: dat trong lab/block-agent.token (da bi .gitignore chan *token*)
BLOCK_AGENT_TOKEN_FILE=/etc/block-agent/token

# --- Splunk ---
SPLUNK_HOME=/opt/splunk
SPLUNK_UF_HOME=/opt/splunkforwarder
ZEEK_HOME=/opt/zeek
