# Copy thanh lab/lab.env (khong commit) va chinh cho dung may that. Moi script trong lab/ doc file nay.
# So do IP: xem docs/network-plan.md. Ten interface: kiem tra bang `ip -br a` tren tung VM.

# --- VM1 Kali (ext-net 10.0.0.0/24) ---
VM1_IF=eth0
VM1_IP=10.0.0.10
VM1_UPDATE_IP=10.0.0.11     # alias: may chu cap nhat lanh tinh
VM1_C2_IP=10.0.0.12         # alias: C2
VM1_EXFIL_IP=10.0.0.13      # alias: dich exfil

# --- VM2 Firewall + Zeek (4 NIC) ---
VM2_IF_EXT=enp0s3
VM2_IF_DMZ=enp0s8
VM2_IF_LAN=enp0s9
VM2_IF_MGMT=enp0s10
VM2_EXT_IP=10.0.0.1
VM2_DMZ_IP=10.0.1.1
VM2_LAN_IP=10.0.2.1
VM2_MGMT_IP=10.0.9.1

# --- VM3 Web DMZ (dmz-net 10.0.1.0/24) ---
VM3_IF=enp0s3
VM3_IP=10.0.1.10

# --- VM4 LAN server: MySQL, file share, resolver (lan-net 10.0.2.0/24) ---
VM4_IF=enp0s3
VM4_IP=10.0.2.10
VM4_RESOLVER_IP=10.0.2.10

# --- VM6 LAN workstation (lan-net) ---
VM6_IF=enp0s3
VM6_IP=10.0.2.21
VM6_ALIAS_IP=10.0.2.22      # alias thu 2: them 1 danh tinh may tram tren cung VM

# --- VM5 Splunk (mgmt-net 10.0.9.0/24) ---
VM5_IF=enp0s3
VM5_IP=10.0.9.10

# --- Subnet ---
EXT_NET=10.0.0.0/24
DMZ_NET=10.0.1.0/24
LAN_NET=10.0.2.0/24
MGMT_NET=10.0.9.0/24

# --- Block Agent ---
BLOCK_AGENT_PORT=8443
# Token KHONG de o day: dat trong /etc/block-agent/token tren VM2
BLOCK_AGENT_TOKEN_FILE=/etc/block-agent/token

# --- Duong dan cai dat ---
SPLUNK_HOME=/opt/splunk
SPLUNK_UF_HOME=/opt/splunkforwarder
ZEEK_HOME=/opt/zeek
